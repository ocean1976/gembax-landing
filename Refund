  .legal-meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.04em; }
  .legal-section { margin-bottom: 2.5rem; }
  .legal-section h2 { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.8rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
  .legal-section h3 { font-size: 0.95rem; font-weight: 600; margin: 1.2rem 0 0.5rem; }
  .legal-section p { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.75; margin-bottom: 0.8rem; }
  .legal-section ul { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.75; margin: 0.5rem 0 1rem 1.5rem; }
  .legal-section li { margin-bottom: 0.3rem; }
  .legal-section a { color: var(--accent); text-decoration: underline; }
  .legal-section strong { color: var(--text-primary); }
  .highlight-box {
    background: var(--bg-card); border: 1px solid var(--border-accent);
    border-left: 3px solid var(--accent); border-radius: 6px;
    padding: 1.2rem 1.5rem; margin: 1.5rem 0;
  }
  .highlight-box p { margin-bottom: 0.4rem; }
  .highlight-box p:last-child { margin-bottom: 0; }
  .steps-row { display: flex; gap: 1rem; margin: 1.5rem 0; flex-wrap: wrap; }
  .step-card {
    flex: 1; min-width: 180px; background: var(--bg-secondary);
    border: 1px solid var(--border); border-radius: 8px; padding: 1.2rem;
  }
  .step-num { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; margin-bottom: 0.5rem; }
  .step-card h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.3rem; }
  .step-card p { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0; }
  footer { border-top: 1px solid var(--border); padding: 2rem 3rem; background: var(--bg-secondary); }
  .footer-inner { max-width: 760px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
  .footer-brand { font-size: 0.85rem; color: var(--text-muted); }
  .footer-brand strong { color: var(--text-primary); font-weight: 700; }
  .footer-brand strong span { color: var(--accent); }
  .footer-links { display: flex; gap: 1.2rem; }
  .footer-links a { color: var(--text-muted); text-decoration: none; font-size: 0.8rem; transition: color 0.2s; }
  .footer-links a:hover { color: var(--accent); }
  @media (max-width: 600px) {
    nav { padding: 1rem 1.2rem; } .logo-sub { display: none; }
    .legal-container { padding: 2.5rem 1.2rem 4rem; }
    .steps-row { flex-direction: column; }
    footer { padding: 1.5rem 1.2rem; }
    .footer-inner { flex-direction: column; gap: 0.8rem; text-align: center; }
  }
</style>
